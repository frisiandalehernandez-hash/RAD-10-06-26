import java.util.Scanner;

public class Diagnostic_Activity_DATATYPES {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("What is your name? ");
        String name = input.nextLine();

        System.out.print("How old are you? ");
        int age = input.nextInt();
        input.nextLine();

        System.out.print("What is your address? ");
        String address = input.nextLine();

        System.out.print("What is your weight (in kg)? ");
        String weight = input.nextLine();

        System.out.print("What is your height (in cm)? ");
        String height = input.nextLine();

        System.out.print("My name is " + name + ", I am " + age + " years old. " + "I live in " + address + ". My weight is " + weight + " and I measure about " + height );
    }
}

import java.util.Scanner;

public class Diagnostic_Activity_SWITCHCASE {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        char again;

        do {
            System.out.print("Enter value of X: ");
            double x = input.nextDouble();

            System.out.print("Enter value of Y: ");
            double y = input.nextDouble();

            System.out.print("Choose operator (+, -, *, /): ");
            char operator = input.next().charAt(0);

            double result = 0;

            switch (operator) {
                case '+':
                    result = x + y;
                    break;
                case '-':
                    result = x - y;
                    break;
                case '*':
                    result = x * y;
                    break;
                case '/':
                    if (y == 0) {
                        System.out.println("Cannot divide by zero.");
                        return;
                    }
                    result = x / y;
                    break;
                default:
                    System.out.println("Invalid operator.");
                    return;
            }

            System.out.println("Result: " + result);

            System.out.print("Do you want to continue?: ");
            again = input.next().charAt(0);

        } while (again == 'y' || again == 'Y');
    }
}
